        </mxCell>
        <mxCell id="7hjFwTFnEjdjfbLLBP7z-107" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notes:&lt;/h1&gt;&lt;p&gt;Process A: uses API calls to fetch SMILES, synonyms, CAS, PubChem CID, ChEMBL ID, etc.&lt;/p&gt;&lt;li data-start=&quot;2192&quot; data-end=&quot;2332&quot;&gt;&lt;p data-start=&quot;2194&quot; data-end=&quot;2332&quot;&gt;Process B: fetches all relevant bioactivity data for specified targets (e.g. RARG, RARA, RARB), binding assays, functional assays, etc.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2192&quot; data-end=&quot;2332&quot;&gt;&lt;p data-start=&quot;2194&quot; data-end=&quot;2332&quot;&gt;Process C: cleans data, unifies identifiers, converts units, removes duplicates (e.g. via canonical SMILES or InChIKey), merges metadata + bioactivity.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2192&quot; data-end=&quot;2332&quot;&gt;&lt;p data-start=&quot;2194&quot; data-end=&quot;2332&quot;&gt;Process D: applies user-defined filters (e.g. potency threshold, subtype selectivity, assay type preference), flags off-target activities.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2633&quot; data-end=&quot;2793&quot;&gt;&lt;p data-start=&quot;2635&quot; data-end=&quot;2793&quot;&gt;Process E: writes final candidate list(s) to output format(s) and possibly summary statistics / reports (e.g. potency distributions, selectivity breakdown).&lt;/p&gt;&lt;/li&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="540" x="100" y="720" as="geometry" />
        </mxCell>
      </root>
